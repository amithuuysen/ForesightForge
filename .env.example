# ─── Evidence graph ───────────────────────────────────────────────────────────
NEO4J_AUTH=neo4j/foresightforge-local
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=foresightforge-local

# ─── Service wiring ───────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# ─── Model provider ───────────────────────────────────────────────────────────
# The council auto-detects a provider in this order:
#   nvidia -> anthropic -> gemini -> groq -> openai -> custom
# Set LLM_PROVIDER to force one. Per-request selection is also supported by the
# UI (the model configuration panel) and the /api/runs endpoints.
LLM_PROVIDER=
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=

# Optional explicit provider keys. Set whichever you have; the first match wins.
NVIDIA_API_KEY=
NIM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# ─── Research workflow bounds ─────────────────────────────────────────────────
MAX_WORKFLOW_ROUNDS=2
# Model calls per run. The council needs one per stage plus one per research
# subagent; 24 covers the default 12 stages with 3 subagents.
MAX_TOOL_CALLS=24
# Wall-clock budget for a run.
RUN_TIMEOUT_SECONDS=900
# Parallel research subagents dispatched per investigation.
MAX_SUBAGENTS=3
# Iterative attempts used to resolve contested council points.
MAX_ATTEMPTS=2
# Convergence score (0-1) at which the council stops iterating.
CONVERGENCE_THRESHOLD=0.85
# Characters of retrieved source text passed to the model as context.
CONTEXT_CHARS=12000
LLM_TEMPERATURE=0.2
# Token budget for a single model call. A stage that returns a large structured
# document (the research plan, the architecture, the idea board) needs room.
# If a provider truncates the response, the call is retried with a larger
# budget, up to LLM_MAX_TOKEN_RETRIES times, never exceeding the ceiling.
LLM_MAX_TOKENS=8192
LLM_MAX_TOKEN_RETRIES=3
LLM_MAX_TOKENS_CEILING=131072
# Per-call timeout. A local or self-hosted model can take a minute or more per
# call when reasoning through a long structured response, so this is sized for
# that rather than for a fast hosted API.
LLM_TIMEOUT_SECONDS=300

# ─── Model role routing ───────────────────────────────────────────────────────
# Role -> tier -> model map lives in config/models.yaml. Point this elsewhere
# to override it. Never hardcode model ids in code.
MODELS_CONFIG_PATH=
# Optional per-role provider pin, e.g. critic=nvidia:meta/llama-3.3-70b-instruct
# Leave blank to use the run's default provider for every role.
ROLE_SKEPTIC_PROVIDER=
ROLE_IDEATOR_PROVIDER=

# ─── Run limits and budget ────────────────────────────────────────────────────
# Default depth per run: quick | standard | deep
DEFAULT_DEPTH=standard
# Hard per-run spend ceiling in USD. The run stops calling models once spent.
DEFAULT_MAX_USD=5.0
# Absolute ceiling a user request may ask for.
MAX_USD_CEILING=50.0
DEPTH_QUICK_ROUNDS=1
DEPTH_STANDARD_ROUNDS=2
DEPTH_DEEP_ROUNDS=4
DEPTH_QUICK_QUERIES=2
DEPTH_STANDARD_QUERIES=3
DEPTH_DEEP_QUERIES=5
DEPTH_QUICK_SOURCES=4
DEPTH_STANDARD_SOURCES=6
DEPTH_DEEP_SOURCES=10

# ─── Topic Discovery bounds ───────────────────────────────────────────────────
DISCOVERY_ENABLED=true
# Panel debate rounds before synthesis.
MAX_PANEL_ROUNDS=3
# Convergence at which the panel stops debating.
PANEL_CONVERGENCE_THRESHOLD=0.8
MAX_SUBTOPICS=7
MAX_PAIN_POINTS=24
MAX_PROBLEM_CANDIDATES=8
# A problem must cite at least this many evidence ids to be ranked.
MIN_EVIDENCE_PER_PROBLEM=1
# How many problems auto-selection picks when the user defers to the council.
AUTO_SELECT_TOP_N=1

# ─── Web search and page retrieval bounds ─────────────────────────────────────
MAX_QUERIES=3
RESULTS_PER_QUERY=5
MAX_SOURCES=6
MAX_FETCH_WORKERS=3
SEARCH_TIMEOUT_SECONDS=12
FETCH_TIMEOUT_SECONDS=8
MAX_REDIRECTS=3
MAX_PAGE_BYTES=1500000
MAX_CONTENT_CHARS=12000
SEARCH_USER_AGENT=ForesightForge/0.1 (evidence research source retrieval)

# ─── Verification policy ──────────────────────────────────────────────────────
# When true, a run only completes if every claim resolves to a retrieved passage.
REQUIRE_CITATION=true
# When true, the research pipeline stops at the shortlist for human approval.
REQUIRE_HUMAN_CHECKPOINT=false
